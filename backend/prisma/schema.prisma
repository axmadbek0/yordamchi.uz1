generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  id           String         @id @default(uuid())
  number       Int            @unique // e.g. 71, 12
  name         String
  address      String?
  region       String?
  phone        String?
  description  String?
  photos       String?        // JSON string array e.g. '["photo1.jpg"]'
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  users        User[]
  students     Student[]
  cameras      Camera[]
  announcements Announcement[]
}

model User {
  id                   String         @id @default(uuid())
  login                String         @unique // e.g. "admin71", "umumi", "12_001"
  password_hash        String
  role                 String         @default("PARENT") // SUPER_ADMIN, SCHOOL_ADMIN, TEACHER, PARENT
  full_name            String?
  phone                String?
  class_name           String?        // For teachers: e.g. "4-A sinf"
  must_change_password Boolean        @default(false)
  last_login_at        DateTime?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  school_id            String?
  school               School?        @relation(fields: [school_id], references: [id])

  students             Student[]      @relation("ParentToStudent")
  chats                Chat[]
  refresh_tokens       RefreshToken[]
}

model RefreshToken {
  id         String    @id @default(uuid())
  token_hash String    @unique
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
}

model Student {
  id            String    @id @default(uuid())
  first_name    String
  last_name     String
  class_name    String    // e.g. "4-A sinf"
  diagnosis     String?
  dob           DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  school_id     String
  school        School    @relation(fields: [school_id], references: [id])

  parent_id     String?
  parent        User?     @relation("ParentToStudent", fields: [parent_id], references: [id])

  logs          DailyLog[]
}

model DailyLog {
  id            String    @id @default(uuid())
  mood          String
  health        String
  teacher_note  String
  ai_analysis   String?
  date          DateTime  @default(now())

  student_id    String
  student       Student   @relation(fields: [student_id], references: [id])
}

model Camera {
  id           String    @id @default(uuid())
  school_id    String
  school       School    @relation(fields: [school_id], references: [id])
  type         String    // DORMITORY, KITCHEN
  sector_label String    // e.g. "1-yotoqxona (O'g'il bolalar)", "Oshxona zali"
  stream_url   String?
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())
}

model Announcement {
  id              String    @id @default(uuid())
  school_id       String
  school          School    @relation(fields: [school_id], references: [id])
  sender_id       String
  title           String
  body            String
  type            String    @default("announcement") // pickup_request, announcement, urgent
  target_classes  String?   // JSON array e.g. '["4-A sinf"]' or null for all
  delivered_count Int       @default(0)
  created_at      DateTime  @default(now())
}

model Chat {
  id         String    @id @default(uuid())
  created_at DateTime  @default(now())

  user_id    String
  user       User      @relation(fields: [user_id], references: [id])

  messages   Message[]
}

model Message {
  id          String     @id @default(uuid())
  sender_type String     @default("USER")
  content     String
  created_at  DateTime   @default(now())

  chat_id     String
  chat        Chat       @relation(fields: [chat_id], references: [id])
}
