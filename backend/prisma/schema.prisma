generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
}

enum SenderType {
  USER
  AI
  ADMIN
}

model School {
  id         String   @id @default(uuid())
  number     Int      @unique
  name       String
  region     String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users      User[]
  students   Student[]
}

model User {
  id            String    @id @default(uuid())
  login         String    @unique // e.g. "umumi" or "12_001"
  password_hash String
  role          Role
  full_name     String?
  phone         String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  school_id     String?
  school        School?   @relation(fields: [school_id], references: [id])

  students      Student[] @relation("ParentToStudent")

  chats         Chat[]
  refresh_tokens RefreshToken[]
}

model RefreshToken {
  id         String    @id @default(uuid())
  token_hash String    @unique
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
}

model Student {
  id            String    @id @default(uuid())
  first_name    String
  last_name     String
  class_name    String    // e.g. "2-A sinf"
  diagnosis     String?
  dob           DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  school_id     String
  school        School    @relation(fields: [school_id], references: [id])

  parent_id     String?
  parent        User?     @relation("ParentToStudent", fields: [parent_id], references: [id])

  logs          DailyLog[]
}

model DailyLog {
  id            String    @id @default(uuid())
  mood          String
  health        String
  teacher_note  String
  ai_analysis   String?   @db.Text
  date          DateTime  @default(now())

  student_id    String
  student       Student   @relation(fields: [student_id], references: [id])
}

model Chat {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())

  user_id    String
  user       User     @relation(fields: [user_id], references: [id])

  messages   Message[]
}

model Message {
  id          String     @id @default(uuid())
  sender_type SenderType
  content     String     @db.Text
  created_at  DateTime   @default(now())

  chat_id     String
  chat        Chat       @relation(fields: [chat_id], references: [id])
}
